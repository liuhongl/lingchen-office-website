    {
      "id": "p-005",
      "type": "heading",
      "text": "核心判断",
      "segments": [
        {
          "text": "核心判断",
          "bold": true,
          "color": "#1F4E79",
          "fontSizePt": 13.0
        }
      ],
      "layout": {
        "spaceBeforeTwips": 160,
        "spaceAfterTwips": 100,
