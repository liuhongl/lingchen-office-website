    },
    {
      "id": "p-045",
      "type": "paragraph",
      "text": "图7　合规闸门把高风险动作挡在自动流程之外，显著降低事后补救成本",
      "segments": [
        {
          "text": "图7　合规闸门把高风险动作挡在自动流程之外，显著降低事后补救成本",
          "bold": true,
          "fontSizePt": 10.0
        }
      ],
      "layout": {
