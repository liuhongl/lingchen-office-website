    {
      "id": "p-027",
      "type": "heading",
      "text": "六、30 天跑通最小场景：可复制的执行清单",
      "segments": [
        {
          "text": "六、30 天跑通最小场景：可复制的执行清单",
          "bold": true,
          "color": "#000000",
