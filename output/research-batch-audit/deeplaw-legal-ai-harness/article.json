      "type": "figure",
      "src": "/images/research/deeplaw-legal-ai-harness/figure-01.png",
      "sourceMedia": "/word/media/image1.png",
      "sha256": "4ee4846850b5b5f0a1ac1b88eea683c3513e0c8de35a0e9679c6ea0eecdc4cd7",
      "width": 1500,
      "height": 850,
      "caption": "",
      "sourceKind": "paragraph",
