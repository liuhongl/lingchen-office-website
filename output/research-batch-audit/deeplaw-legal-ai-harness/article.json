    {
      "id": "p-040",
      "type": "heading",
      "text": "八、如何开始：体验方式与开通建议",
      "segments": [
        {
          "text": "八、如何开始：体验方式与开通建议",
          "bold": true,
          "color": "#000000",
          "fontSizePt": 14.0
        }
      ],
      "layout": {
        "spaceBeforeTwips": 280,
        "spaceAfterTwips": 180,
        "fontSizePt": 14.0
