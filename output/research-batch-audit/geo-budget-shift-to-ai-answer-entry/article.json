        ]
      ],
      "captionPosition": "after",
      "captionSegments": [
        {
          "text": "表1｜SEO/SEM 与 GEO 的预算对象差异：目标、资产、监测与转化路径对照",
          "bold": true,
          "color": "#595959",
          "fontSizePt": 10.0
        }
      ],
      "captionLayout": {
        "spaceBeforeTwips": 60,
        "spaceAfterTwips": 280,
